# API base URL the SPA calls. In dev point at the Laravel server; in production use
# the same-origin path proxied by nginx.
VITE_API_URL=http://localhost:8000/api

# Seller WhatsApp number for the "checkout → send order on WhatsApp" flow.
# Digits only, with country code, no '+'. Example: 6281234567890
VITE_WHATSAPP_NUMBER=6281234567890

# Store name inserted into the WhatsApp order message.
VITE_STORE_NAME=Aniata
